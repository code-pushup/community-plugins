{
  "extends": ["../../.eslintrc.json"],
  "ignorePatterns": ["!**/*", "**/mocks/**"],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "parserOptions": {
        "project": ["testing/test-utils/tsconfig.*?.json"]
      }
    },
    {
      "files": ["*.json"],
      "parser": "jsonc-eslint-parser",
      "rules": {
        "@nx/dependency-checks": ["error"]
      }
    }
  ]
}
